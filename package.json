{
  "name": "listenly-voice",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.player.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/js/tsconfig.json --noEmit",
    "dev:player": "vite build -c vite.player.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:php": "vendor/bin/phpunit"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
